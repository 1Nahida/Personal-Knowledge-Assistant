# ============ PKA 环境配置模板 ============
# 复制为 .env 后按需修改：  copy .env.example .env

# ---- 模型源：ollama / dashscope / deepseek ----
MODEL_PROVIDER=ollama

# ---- Ollama（本地，默认） ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1

# ---- 阿里云百炼 DashScope（可选） ----
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- DeepSeek（可选） ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Embedding ----
# ollama = 走 Ollama 的向量模型（bge-m3 中文友好，推荐；nomic-embed-text 更轻量）
# hash   = 内置确定性向量，仅用于单元测试/离线演示
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=16

# ---- 检索 ----
TOP_K=5
SCORE_THRESHOLD=0.0

# ---- 分块 ----
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# ---- 运行开关 ----
ENABLE_FALLBACK=true
REQUEST_TIMEOUT=120

# ---- 路径（可选，默认项目内 data/ 与 logs/） ----
# PKA_DATA_DIR=
# PKA_LOG_DIR=

# 关闭 chromadb 匿名遥测：其 posthog 版本不兼容，会持续往 stderr 刷
# "Failed to send telemetry event ..."，干扰日志与测试输出。
ANONYMIZED_TELEMETRY=False
